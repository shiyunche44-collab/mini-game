{
  "name": "pack-the-suitcase",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "node tools/check.mjs",
    "check:arch": "node tools/check-arch.mjs",
    "check:size": "node tools/check-size.mjs",
    "typecheck": "node tools/typecheck.mjs",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\" \"tools/**/*.test.mjs\"",
    "build:web": "node tools/build.mjs web",
    "dev": "node tools/build.mjs web --serve",
    "smoke": "node --test --test-reporter=spec tools/smoke.mjs",
    "levels:preview": "node tools/levels-preview.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "minigame-api-typings": "^3.8.21",
    "playwright": "1.56.1",
    "typescript": "~6.0.3"
  }
}
